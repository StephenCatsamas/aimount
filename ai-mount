#!/usr/bin/env bash
set -euo pipefail

# Usage: sudo ai-mount DIRECTORY [NAME]
source=$(realpath -e -- "${1:?Usage: sudo ai-mount DIRECTORY [NAME]}")
name=${2:-$(basename "$source")}
view="/srv/ai-workspaces/$name"

[[ -d "$source" ]] || { echo "Not a directory: $source" >&2; exit 1; }
[[ "$source" != / ]] || { echo "Refusing to share /" >&2; exit 1; }
[[ -n "$name" && "$name" != . && "$name" != .. && "$name" != */* ]] || { echo "Invalid workspace name: $name" >&2; exit 1; }

# Expose the original directory without opening access to its parents.
mkdir -p "$view"                       # Also works after a reboot.
if mountpoint -q "$view" || [[ -n $(ls -A "$view") ]]; then
    echo "Mount point already in use: $view" >&2
    exit 1
fi
mount --bind "$source" "$view"
mount --make-private "$view"          # Keep nested mounts out of the original path.

# If this is a normal Git checkout, protect .git through the shared path.
if [[ -d "$source/.git" && ! -L "$source/.git" ]]; then
    mount --bind "$source/.git" "$view/.git"
    mount -o remount,bind,ro "$view/.git"
fi

# Keep file owners unchanged; let members of ai-edit work on the same files.
chgrp -R ai-edit "$source"
find "$source" -path "$source/.git" -prune -o -type d -exec chmod g+rwx,g+s {} +
find "$source" -path "$source/.git" -prune -o -type f -exec chmod g+rwX {} +
find "$source" -path "$source/.git" -prune -o -type d -exec setfacl -m d:g::rwx {} +

# Git metadata stays group-readable but not group-writable.
if [[ -d "$source/.git" && ! -L "$source/.git" ]]; then
    find "$source/.git" -type d -exec chmod g+rx,g-w,g+s {} +
    find "$source/.git" -type f -exec chmod g+r,g-w {} +
    find "$source/.git" -type d -exec setfacl -m d:g::r-x {} +
fi

echo "Mounted: $view"
